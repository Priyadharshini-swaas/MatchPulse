default_platform(:ios)

platform :ios do

  # ── Lane 1: Build only (no signing, simulator) ──────────
  lane :build_only do
    xcodebuild(
      scheme: "MatchPulse",
      project: "MatchPulse.xcodeproj",
      destination: "generic/platform=iOS Simulator",
      build_settings: {
        "CODE_SIGNING_ALLOWED" => "NO",
        "CODE_SIGN_IDENTITY" => "",
        "CODE_SIGNING_REQUIRED" => "NO"
      }
    )
  end

  # ── Lane 2: Build + Distribute to Firebase ──────────────
  lane :firebase do
    create_keychain(
      name: "ci_keychain",
      password: "ci_password",
      default_keychain: true,
      unlock: true,
      timeout: 3600
    )

    update_code_signing_settings(
      use_automatic_signing: true,
      path: "MatchPulse.xcodeproj"
    )

    build_app(
      scheme: "MatchPulse",
      project: "MatchPulse.xcodeproj",
      export_method: "development",
      output_directory: "./build",
      output_name: "MatchPulse.ipa",
      export_options: {
        compileBitcode: false,
        signingStyle: "automatic",
        teamID: ENV["APPLE_TEAM_ID"]
      }
    )

    firebase_app_distribution(
      app: "1:981198068719:ios:e418854ab4273d90fbf41a",
      testers: "priyaparthiban702@gmail.com",
      release_notes: "Build #{ENV['GITHUB_RUN_NUMBER']} - #{ENV['GITHUB_SHA'][0..6]}",
      service_credentials_json_data: ENV["FIREBASE_SERVICE_ACCOUNT_JSON"],
      ipa_path: "./build/MatchPulse.ipa"
    )
  end

end
