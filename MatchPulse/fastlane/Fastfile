default_platform(:ios)

platform :ios do

  lane :test do
    run_tests(
      scheme: "MatchPulse",
      devices: ["iPhone 16"],
      clean: true
    )
  end

  lane :build_only do
  xcodebuild(
    scheme: "MatchPulse",
    project: "MatchPulse.xcodeproj",
    destination: "generic/platform=iOS Simulator",
    build_settings: {
      "CODE_SIGNING_ALLOWED" => "NO",
      "CODE_SIGN_IDENTITY" => "",
      "CODE_SIGNING_REQUIRED" => "NO"
    }
  )
end

end