lane :firebase do
  # Build the app (no signing needed for Firebase)
  xcodebuild(
    scheme: "MatchPulse",
    project: "MatchPulse.xcodeproj",
    destination: "generic/platform=iOS Simulator",
    build_settings: {
      "CODE_SIGNING_ALLOWED" => "NO",
      "CODE_SIGN_IDENTITY" => "",
      "CODE_SIGNING_REQUIRED" => "NO"
    }
  )

  firebase_app_distribution(
    app: "1:981198068719:ios:e418854ab4273d90fbf41a",  # your Firebase App ID
    testers: "priyaparthiban702@gmail.com",
    release_notes: "Build from CI - #{ENV['GITHUB_SHA']}",
    service_credentials_json_data: ENV["FIREBASE_SERVICE_ACCOUNT_JSON"]
  )
end
