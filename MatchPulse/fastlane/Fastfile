default_platform(:ios)

platform :ios do

  # ── Lane 1: Run unit tests ──────────────────────────────
  lane :test do
    run_tests(
      scheme: "MatchPulse",
      devices: ["iPhone 16"],
      clean: true
    )
  end

  # ── Lane 2: Build only (no signing, simulator) ──────────
  lane :build_only do
    xcodebuild(
      scheme: "MatchPulse",
      project: "MatchPulse.xcodeproj",
      destination: "generic/platform=iOS Simulator",
      build_settings: {
        "CODE_SIGNING_ALLOWED" => "NO",
        "CODE_SIGN_IDENTITY" => "",
        "CODE_SIGNING_REQUIRED" => "NO"
      }
    )
  end

  # ── Lane 3: Build + Distribute to Firebase ──────────────
  lane :firebase do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"]
    )

    match(
      type: "adhoc",
      api_key: api_key,
      readonly: true
    )

    build_app(
      scheme: "MatchPulse",
      project: "MatchPulse.xcodeproj",
      export_method: "ad-hoc",
      output_directory: "./build",
      output_name: "MatchPulse.ipa"
    )

    firebase_app_distribution(
      app: ENV["1:981198068719:ios:e418854ab4273d90fbf41a"],
      testers: "priyaparthiban702@gmail.com",
      release_notes: "Build #{ENV['GITHUB_RUN_NUMBER']} - #{ENV['GITHUB_SHA'][0..6]}",
      service_credentials_json_data: ENV["FIREBASE_SERVICE_ACCOUNT_JSON"],
      ipa_path: "./build/MatchPulse.ipa"
    )
  end

  # ── Lane 4: Build + Upload to TestFlight ────────────────
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"]
    )

    match(
      type: "appstore",
      api_key: api_key,
      readonly: true
    )

    increment_build_number

    build_app(
      scheme: "MatchPulse",
      project: "MatchPulse.xcodeproj",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "MatchPulse.ipa"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

end
